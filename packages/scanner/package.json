{
  "name": "@edge/scanner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "start:funding": "tsx src/runners/funding-runner.ts",
    "start:funding-combined": "tsx src/runners/funding-combined-runner.ts",
    "start:all": "tsx src/runners/all-runner.ts",
    "start:dexcex": "tsx src/runners/dexcex-runner.ts",
    "start:prediction": "tsx src/runners/prediction-runner.ts",
    "start:discover": "tsx src/runners/discover-runner.ts",
    "start:dashboard": "tsx src/runners/dashboard.ts",
    "start:khype-carry": "tsx src/runners/khype-carry-executor.ts",
    "start:euler-arb": "tsx src/runners/euler-lending-executor.ts",
    "start:commands": "tsx src/runners/command-handler.ts --loop",
    "start:daily-report": "tsx src/runners/daily-report.ts"
  },
  "dependencies": {
    "@edge/types": "workspace:*",
    "@edge/config": "workspace:*",
    "@edge/alerts": "workspace:*",
    "@edge/pnl": "workspace:*",
    "@edge/risk": "workspace:*",
    "@edge/sharpe-client": "workspace:*",
    "@edge/vooi-client": "workspace:*",
    "@edge/pumpapi-client": "workspace:*",
    "@edge/executor": "workspace:*",
    "viem": "^2.21.0",
    "@edge/backpack-client": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "tsx": "^4.19.0"
  }
}