# Edge-Engine secrets template — fill in real values, save as .env
# NEVER commit the .env file (it's gitignored).
# This file is a placeholder only — no real secrets here.

# ─── RPC providers ─────────────────────────────────────
HELIUS_API_KEY=
ALCHEMY_API_KEY=

# ─── Exchange APIs (read-only for now; upgrade to trade later) ─
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
# OKX_API_KEY=
# OKX_API_SECRET=
# OKX_API_PASSPHRASE=
# BYBIT_API_KEY=
# BYBIT_API_SECRET=
# HYPERLIQUID_WALLET_PK=
# HYPERLIQUID_ACCOUNT_ADDRESS=

# ─── Signal & execution APIs ──────────────────────────
SHARPE_API_KEY=
VOOI_API_TOKEN=
COINGLASS_API_KEY=
ODDSSHOPPER_API_KEY=

# ─── Prediction-market wallets ────────────────────────
POLYMARKET_WALLET_PK=

# ─── Risk envelope ────────────────────────────────────
WORKING_CAPITAL_USD=10000
MAX_DAILY_LOSS_USD=200
MAX_PER_TRADE_LOSS_USD=50
MAX_CONCURRENT_ARBS=3
GAS_PRICE_CAP_MULT=3
COOLDOWN_MS=300000
LEVERAGE_CAP=3

# ─── Alerts ───────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Server ───────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ─── Agent wallets (generated by `pnpm --filter @edge/data-sources gen:agent-wallets`) ───
# Agent EOA wallet — signs all routine transactions.
# The private key NEVER leaves .env. The address is public.
# Run `pnpm --filter @edge/data-sources gen:agent-wallets` to generate.
AGENT_EVM_PRIVATE_KEY=
AGENT_EVM_ADDRESS=
AGENT_SOLANA_PRIVATE_KEY=
AGENT_SOLANA_ADDRESS=

# ─── Principal wallet (the OWNER of AgentVault) ───
# Required for `pnpm --filter @edge/contracts deploy --chain=<chain>`
# This is the principal's address (NOT a private key — agent never holds it).
# Principal retains: owner authority, profit recipient, recovery valve.
PRINCIPAL_EVM_ADDRESS=
PRINCIPAL_SOL_ADDRESS=

# ─── Deployed AgentVault addresses (populated by deploy script) ───
# Format: AGENT_VAULT_ADDRESS_<CHAIN>=0x...
# Example: AGENT_VAULT_ADDRESS_BASE=0x...
#AGENT_VAULT_ADDRESS_BASE=
#AGENT_VAULT_ADDRESS_ARBITRUM=
